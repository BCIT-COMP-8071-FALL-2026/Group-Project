        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    Person ||--o| Senior : \&quot;is\&quot;\n    Person ||--o| FamilyMember : \&quot;is\&quot;\n    Person ||--o| Caregiver : \&quot;is\&quot;\n    Person ||--o| AgencyManager : \&quot;is\&quot;\n    Person ||--o| UserAccount : \&quot;logs in as\&quot;\n    UserAccount ||--o{ UserAccountRole : has\n    Role ||--o{ UserAccountRole : grants\n    UserAccount ||--o{ Visit : \&quot;scheduled by\&quot;\n    Senior ||--o{ SeniorFamilyMember : has\n    FamilyMember ||--o{ SeniorFamilyMember : linked\n    Agency ||--o{ Caregiver : employs\n    Agency ||--o{ AgencyManager : managed_by\n    Agency ||--o{ Visit : \&quot;agency at visit time\&quot;\n    Senior ||--o{ Visit : receives\n    Caregiver ||--o{ Visit : performs\n    Service ||--o{ Visit : type\n    Visit ||--o{ VisitNote : has\n    Caregiver ||--o{ VisitNote : writes\n\n    Person {\n        int PersonID PK\n        string FirstName\n        string MiddleName \&quot;nullable\&quot;\n        string LastName\n        string Street\n        string City\n        string Province\n        string Country\n        string PostalCode\n        string Phone\n    }\n    UserAccount {\n        string UserAccountID PK \&quot;extends IdentityUser\&quot;\n        int PersonID FK \&quot;unique\&quot;\n        string Email \&quot;unique, login (Identity)\&quot;\n    }\n    Role {\n        string RoleID PK \&quot;Identity role\&quot;\n        string Name \&quot;Senior/Family/Caregiver/Admin/AgencyManager\&quot;\n    }\n    UserAccountRole {\n        string UserAccountID PK,FK\n        string RoleID PK,FK\n    }\n    Senior {\n        int SeniorID PK,FK\n        date DateOfBirth\n        bool IsLivingAlone\n        string CurrentDoctorName \&quot;nullable\&quot;\n        string CurrentDoctorPhone \&quot;nullable\&quot;\n        text MedicalConditions \&quot;nullable\&quot;\n        text CurrentMedication \&quot;nullable\&quot;\n        string EmergencyContactName \&quot;nullable\&quot;\n        string EmergencyContactPhone \&quot;nullable\&quot;\n        string EmergencyContactRelationship \&quot;nullable\&quot;\n        string Status \&quot;Active/Deactivated\&quot;\n        datetime DeactivatedAt \&quot;nullable\&quot;\n    }\n    FamilyMember {\n        int FamilyMemberID PK,FK\n    }\n    SeniorFamilyMember {\n        int SeniorID PK,FK\n        int FamilyMemberID PK,FK\n    }\n    Agency {\n        int AgencyID PK\n        string Name\n        string Street\n        string City\n        string Province\n        string Country\n        string PostalCode\n        string Phone\n        string Email\n    }\n    AgencyManager {\n        int AgencyManagerID PK,FK\n        int AgencyID FK\n    }\n    Caregiver {\n        int CaregiverID PK,FK\n        int AgencyID FK \&quot;exactly one\&quot;\n    }\n    Visit {\n        int VisitID PK\n        int SeniorID FK\n        int ServiceID FK \&quot;visit type\&quot;\n        int CaregiverID FK \&quot;assigned caregiver\&quot;\n        int AgencyID FK \&quot;snapshot of caregiver agency at scheduling\&quot;\n        string CreatedByUserID FK \&quot;admin who scheduled\&quot;\n        datetime ScheduledStart\n        datetime ActualCheckIn \&quot;nullable\&quot;\n        datetime ActualCheckOut \&quot;nullable\&quot;\n        string Status \&quot;Scheduled/InProgress/Completed/Cancelled; Missed is computed\&quot;\n        string DestinationAddress \&quot;nullable\&quot;\n    }\n    VisitNote {\n        int NoteID PK\n        int VisitID FK\n        int CaregiverID FK \&quot;author\&quot;\n        text NoteText\n        datetime CreatedAt\n    }\n    Service {\n        int ServiceID PK\n        string ServiceName\n        text Description \&quot;nullable\&quot;\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JioHmL50UpgDJArtu6UV-1">
