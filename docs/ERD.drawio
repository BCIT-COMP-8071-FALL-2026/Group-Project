        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    Person ||--o| Senior : \&quot;is\&quot;\n    Person ||--o| FamilyMember : \&quot;is\&quot;\n    Person ||--o| Caregiver : \&quot;is\&quot;\n    Person ||--o| AgencyManager : \&quot;is\&quot;\n    Person ||--o| UserAccount : \&quot;logs in as\&quot;\n    UserAccount ||--o{ UserAccountRole : has\n    Role ||--o{ UserAccountRole : grants\n    UserAccount ||--o{ AuditLog : performs\n    UserAccount ||--o{ Visit : \&quot;scheduled by\&quot;\n    Senior ||--o{ SeniorFamilyMember : has\n    FamilyMember ||--o{ SeniorFamilyMember : linked\n    Agency ||--o{ Caregiver : employs\n    Agency ||--o{ AgencyManager : managed_by\n    Agency ||--o{ Visit : \&quot;agency at visit time\&quot;\n    Caregiver ||--o{ CaregiverAvailability : has\n    Senior ||--o{ CaregiverAssignment : assigned\n    Caregiver ||--o{ CaregiverAssignment : assigned\n    Senior ||--o{ Visit : receives\n    Caregiver ||--o{ Visit : performs\n    Service ||--o{ Visit : type\n    Visit ||--o{ VisitNote : has\n    Caregiver ||--o{ VisitNote : writes\n    Senior ||--o{ Medication : takes\n\n    Person {\n        int PersonID PK\n        string FirstName\n        string MiddleName \&quot;nullable\&quot;\n        string LastName\n        string ContactEmail \&quot;nullable, not used for login\&quot;\n        string Street\n        string City\n        string Province\n        string Country\n        string PostalCode\n        string Phone\n    }\n    UserAccount {\n        string UserAccountID PK \&quot;extends IdentityUser\&quot;\n        int PersonID FK \&quot;unique\&quot;\n        string Email \&quot;unique, login (Identity)\&quot;\n        bool IsActive\n    }\n    Role {\n        string RoleID PK \&quot;Identity role\&quot;\n        string Name \&quot;Senior/Family/Caregiver/Admin/AgencyManager\&quot;\n    }\n    UserAccountRole {\n        string UserAccountID PK,FK\n        string RoleID PK,FK\n    }\n    AuditLog {\n        int AuditLogID PK\n        string UserAccountID FK\n        string Action \&quot;AdminPromotion, SensitiveRead, etc\&quot;\n        string EntityName\n        string EntityID\n        datetime CreatedAt\n    }\n    Senior {\n        int SeniorID PK,FK\n        varbinary SINEncrypted\n        string SINLast3 \&quot;display only\&quot;\n        date DateOfBirth\n        bool IsLivingAlone\n        text AdditionalNotes \&quot;nullable\&quot;\n        string CurrentDoctorName \&quot;nullable\&quot;\n        string CurrentDoctorPhone \&quot;nullable\&quot;\n        string InsuranceCompany \&quot;nullable\&quot;\n        varbinary InsuranceAccountNoEncrypted \&quot;nullable\&quot;\n        text MedicalConditions \&quot;nullable\&quot;\n        string Status \&quot;Active/PendingDeactivation/Deactivated/Archived\&quot;\n        datetime DeactivationRequestedAt \&quot;nullable\&quot;\n        datetime DeactivatedAt \&quot;nullable\&quot;\n        date RetainUntil \&quot;nullable, 5 yr retention\&quot;\n    }\n    FamilyMember {\n        int FamilyMemberID PK,FK\n        string WorkPhone \&quot;nullable\&quot;\n    }\n    SeniorFamilyMember {\n        int SeniorID PK,FK\n        int FamilyMemberID PK,FK\n        string Relationship\n        bool IsEmergencyContact\n        bool IsPowerOfAttorney\n        datetime AccessApprovedAt \&quot;nullable, senior approval (OLTP-11)\&quot;\n        bool CanViewHealth\n    }\n    Agency {\n        int AgencyID PK\n        string Name\n        string Street\n        string City\n        string Province\n        string Country\n        string PostalCode\n        string Phone\n        string Email\n    }\n    AgencyManager {\n        int AgencyManagerID PK,FK\n        int AgencyID FK\n    }\n    Caregiver {\n        int CaregiverID PK,FK\n        int AgencyID FK \&quot;exactly one\&quot;\n        bool IsTrained\n    }\n    CaregiverAvailability {\n        int AvailabilityID PK\n        int CaregiverID FK\n        int DayOfWeek\n        time StartTime\n        time EndTime\n    }\n    CaregiverAssignment {\n        int AssignmentID PK\n        int SeniorID FK\n        int CaregiverID FK \&quot;ongoing relationship\&quot;\n        date StartDate\n        date EndDate \&quot;nullable\&quot;\n    }\n    Visit {\n        int VisitID PK\n        int SeniorID FK\n        int ServiceID FK \&quot;visit type\&quot;\n        int CaregiverID FK \&quot;who actually went\&quot;\n        int AgencyID FK \&quot;snapshot at scheduling\&quot;\n        string CreatedByUserID FK \&quot;admin who scheduled\&quot;\n        datetime ScheduledStart\n        datetime ActualCheckIn \&quot;nullable\&quot;\n        datetime ActualCheckOut \&quot;nullable\&quot;\n        string Status \&quot;Scheduled/InProgress/Completed/Missed/Cancelled\&quot;\n        string CancelReason \&quot;nullable\&quot;\n        string DestinationAddress \&quot;nullable\&quot;\n    }\n    VisitNote {\n        int NoteID PK\n        int VisitID FK\n        int CaregiverID FK \&quot;author\&quot;\n        text NoteText\n        datetime CreatedAt\n        bool IsArchived\n    }\n    Service {\n        int ServiceID PK\n        string ServiceName\n        text Description \&quot;nullable\&quot;\n    }\n    Medication {\n        int MedicationID PK\n        int SeniorID FK\n        string Name\n        string Dosage\n        string Frequency\n        string PrescribedBy \&quot;plain text\&quot;\n        date StartDate\n        date EndDate \&quot;nullable\&quot;\n        date RefillDate \&quot;nullable\&quot;\n        bool IsActive\n    }\n    &quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="joBcxg7sI7t8lLsvq_TY-1">
