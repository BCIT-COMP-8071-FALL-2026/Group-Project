@model List<CaregiverVisitListItem>
@{
    ViewData["Title"] = "My visits";
}

<h1>My visits</h1>

@if (Model.Count == 0)
{
    <p>You have no upcoming visits.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Time (Vancouver time)</th>
                <th scope="col">Patient name</th>
                <th scope="col">Appointment type</th>
                <th scope="col">Resident address</th>
                <th scope="col">Destination address</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var visit in Model)
            {
                <tr>
                    @* Visit page is #63 (O10) *@
                    <td><a asp-action="Details" asp-route-id="@visit.VisitID">@visit.ScheduledStart.ToString("yyyy-MM-dd h:mm tt")</a></td>
                    <td>@visit.SeniorName</td>
                    <td>@visit.ServiceName</td>
                    <td>@visit.ResidentAddress</td>
                    <td>@visit.DestinationAddress</td>
                </tr>
            }
        </tbody>
    </table>
}
