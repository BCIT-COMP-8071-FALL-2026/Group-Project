@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    @* OLTP-2: Staff accounts have no role until Admin assigns one *@
    @if (!RoleNames.All.Any(User.IsInRole))
    {
        <p>Staff tools are coming soon.</p>
    }
    @if (User.IsInRole(RoleNames.FamilyMember))
    {
        <p>Your linked senior's details are coming soon.</p>
    }
</div>
