@model IEnumerable<OLTPApp.Models.Senior>

@{
    ViewData["Title"] = "Manage Seniors";
}


<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Manage Seniors</h2>
            <p class="text-muted mb-0">
                View and manage senior profiles.
            </p>
        </div>

        <a asp-controller="AdminSenior"
           asp-action="CreateSenior"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Senior
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Seniors</p>
                    <h3 class="mb-0">@ViewBag.TotalSeniors</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Search Results</p>
                    <h3 class="mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Current View</p>
                    <h3 class="mb-0">Seniors</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="AdminSenior"
                  asp-action="Seniors"
                  method="get"
                  class="row search-form">

                <div class="search-input">
                    <label for="search" class="form-label">
                        Search seniors
                    </label>

                    <input type="text"
                           id="search"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search by name or phone..." />
                </div>

                <div class="search-btn-group">
                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>

                    <a asp-controller="AdminSenior"
                       asp-action="Seniors"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Senior Directory</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Senior</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Province</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var senior in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @senior.Person.FirstName
                                        @if (!string.IsNullOrWhiteSpace(
                                            senior.Person.MiddleName))
                                        {
                                            @senior.Person.MiddleName
                                        }
                                        @senior.Person.LastName
                                    </div>

                                    <small class="text-muted">
                                        ID: @senior.SeniorID
                                    </small>
                                </td>

                                <td>@senior.Person.Phone</td>
                                <td>@senior.Person.City</td>
                                <td>@senior.Person.Province</td>
                                <td>@senior.Status</td>

                                <td class="text-end">

                                    <a asp-controller="AdminSenior"
                                       asp-action="EditSenior"
                                       asp-route-id="@senior.SeniorID" target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center py-5 text-muted">
                                No seniors found. Try a different search.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white text-muted">
            Showing @Model.Count() senior(s)
        </div>
    </div>
</div>
