@{
	ViewData["Title"] = "Add Medicine";
}

<div class="personal-detail-wrapper profile-page-div">
	<div class="profile-detail-title">
		<span class="detail-title">Add Medicine</span>
	</div>
	<form asp-action="Edit" method="post" enctype="multipart/form-data" class="profile-detail-form personal-detail-form">
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>
		<div class="form-input">
			<label  class="control-label">Medication name</label>
			<input  class="form-control" />
			<span  class="text-danger"></span>
		</div>
		<div class="form-input">
			<label class="control-label">Dose</label>
			<input class="form-control"  />
			<span class="text-danger"></span>
		</div>
		<div class="form-input">
			<label class="control-label">How often</label>
			<input class="form-control" />
			<span class="text-danger"></span>
		</div>
		<div class="form-input">
			<label class="control-label">Prescribed by</label>
			<input class="form-control" type="tel" />
			<span class="text-danger"></span>
		</div>
		<div class="input2">
			<div class="form-input">
				<label class="control-label">Start date</label>
				<input class="form-control" type="date" />
			</div>
			<div class="form-input">
				<label class="control-label">Next refill date</label>
				<input class="form-control" type="date" />
			</div>
		</div>
		<div class="form-input radio-input">
			<label class="control-label">Status </label>
			<div>
					<input type="radio" value="active" id="active" />
					<label for="yes">Active</label>
					<input type="radio" value="stopped" id="stop" />
					<label for="no">Stopped</label>
			</div>
		</div>
		<div class="form-group-btn">
			<button type="submit" class="primary-btn">Save</button>
			<button type="reset" class="secondary-btn">Cancel</button>
		</div>
	</form>
</div>
@section Scripts {
	<script src="~/js/senior-profile.js"
			asp-append-version="true"></script>
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}
