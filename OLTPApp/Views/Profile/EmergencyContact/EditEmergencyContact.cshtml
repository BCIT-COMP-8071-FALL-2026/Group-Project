@model OLTPApp.Models.Person
@{
	ViewData["Title"] = "Edit Emergency";
}


<div class="personal-detail-wrapper profile-page-div">
	<div class="profile-detail-title">
		<span class="detail-title">Add Emergency Contact</span>
	</div>

	<form asp-action="EditEmergencyContact"
		  asp-controller="SeniorProfile"
		  method="post"
		  class="profile-detail-form personal-detail-form">

		@Html.AntiForgeryToken()

		<div asp-validation-summary="ModelOnly" class="text-danger"></div>
		<input type="hidden" asp-for="PersonID" />
		<div class="form-input">
			<label asp-for="FirstName">First Name</label>
			<input asp-for="FirstName" class="form-control" />
			<span asp-validation-for="FirstName" class="text-danger"></span>
		</div>

		<div class="form-input">
			<label asp-for="LastName">Last Name</label>
			<input asp-for="LastName" class="form-control" />
			<span asp-validation-for="LastName" class="text-danger"></span>
		</div>

		<div class="form-input">
			<label asp-for="Phone">Phone Number</label>
			<input asp-for="Phone" class="form-control" type="tel" />
			<span asp-validation-for="Phone" class="text-danger"></span>
		</div>

		<div class="form-input">
			<label for="Relationship">Relationship</label>
			<input type="text" name="relationship" id="Relationship" class="form-control" value="@ViewBag.Relationship" required />
			@Html.ValidationMessage( "relationship", "", new { @class = "text-danger" })
		</div>

		<div class="form-input">
			<label asp-for="Street">Street</label>
			<input asp-for="Street" class="form-control" />
			<span asp-validation-for="Street" class="text-danger"></span>
		</div>

		<div class="form-input">
			<label asp-for="City">City</label>
			<input asp-for="City" class="form-control" />
			<span asp-validation-for="City" class="text-danger"></span>
		</div>

		<div class="form-input">
			<label asp-for="Province">Province</label>
			<input asp-for="Province" class="form-control" />
			<span asp-validation-for="Province" class="text-danger"></span>
		</div>

		<div class="form-input">
			<label asp-for="PostalCode">Postal Code</label>
			<input asp-for="PostalCode" class="form-control" />
			<span asp-validation-for="PostalCode" class="text-danger"></span>
		</div>

		<div class="form-input">
			<label asp-for="Country">Country</label>
			<input asp-for="Country" class="form-control" />
			<span asp-validation-for="Country" class="text-danger"></span>
		</div>

		<div class="form-group-btn">
			<button type="submit" class="primary-btn">Save</button>
			<button type="button" class="secondary-btn"
					onclick="window.location.href='@Url.Action("EmergencyContacts", "SeniorProfile")'">
				Cancel
			</button>
		</div>
	</form>
</div>

@section Scripts {
	<script src="~/js/senior-profile.js"
			asp-append-version="true"></script>
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}


@section Scripts {
	<script src="~/js/senior-profile.js"
			asp-append-version="true"></script>
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}