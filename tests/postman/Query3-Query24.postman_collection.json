    {
      "name": "Query 2/4: Senior outreach",
      "item": [
        {
          "name": "GET senior outreach",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let rows = [];",
                  "try { rows = pm.response.json(); } catch (e) {}",
                  "",
                  "pm.test(\"Status is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Body is a non-empty array\", () => {",
                  "  pm.expect(rows).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "// Same ordering rule as SQL Server's default case-insensitive collation",
                  "const byName = (a, b) => a.localeCompare(b, undefined, { sensitivity: \"base\" });",
                  "",
                  "const AGE_BANDS = [\"Under 65\", \"65-74\", \"75-84\", \"85+\"];",
                  "",
                  "pm.test(\"Each row has exactly seniorName, missedCount, serviceTypes, livesAlone, ageBand\", () => {",
                  "  rows.forEach(r => {",
                  "    pm.expect(Object.keys(r)).to.have.members([\"seniorName\", \"missedCount\", \"serviceTypes\", \"livesAlone\", \"ageBand\"]);",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"Field types match the procedure output\", () => {",
                  "  rows.forEach(r => {",
                  "    pm.expect(r.seniorName).to.be.a(\"string\").that.is.not.empty;",
                  "    pm.expect(Number.isInteger(r.missedCount), `missedCount ${r.missedCount} is an integer`).to.be.true;",
                  "    pm.expect(r.serviceTypes).to.be.a(\"string\").that.is.not.empty;",
                  "    pm.expect(r.livesAlone).to.be.a(\"boolean\");",
                  "    pm.expect(r.ageBand).to.be.a(\"string\");",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"missedCount >= 3 and ageBand is a known band\", () => {",
                  "  rows.forEach(r => {",
                  "    pm.expect(r.missedCount, r.seniorName).to.be.at.least(3);",
                  "    pm.expect(AGE_BANDS, r.seniorName).to.include(r.ageBand);",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"serviceTypes are unique and sorted\", () => {",
                  "  rows.forEach(r => {",
                  "    const services = r.serviceTypes.split(\", \");",
                  "    pm.expect(new Set(services).size, `${r.seniorName} has no duplicate services`).to.equal(services.length);",
                  "    for (let i = 1; i < services.length; i++) {",
                  "      pm.expect(byName(services[i - 1], services[i]) < 0, `${r.seniorName}: ${services[i - 1]} then ${services[i]}`).to.be.true;",
                  "    }",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"Sorted by missedCount descending, then seniorName\", () => {",
                  "  for (let i = 1; i < rows.length; i++) {",
                  "    const a = rows[i - 1], b = rows[i];",
                  "    const ordered = a.missedCount > b.missedCount",
                  "      || (a.missedCount === b.missedCount && byName(a.seniorName, b.seniorName) <= 0);",
                  "    pm.expect(ordered, `${a.seniorName} then ${b.seniorName}`).to.be.true;",
                  "  }",
                  "});",
                  "",
                  "// Saved so \"GET senior outreach with query string (ignored)\" can compare against it",
                  "pm.collectionVariables.set(\"q24Body\", pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/senior-outreach",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "senior-outreach"
              ]
            },
            "description": "Happy path. Checks status, Content-Type, field names, field types, value ranges and sort order. Needs a star schema with at least one senior with 3+ missed visits in the 90 days before the anchor date."
          },
          "response": []
        },
