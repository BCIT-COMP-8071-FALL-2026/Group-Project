    "_postman_id": "52b3fbc6-f941-41b4-b3f6-2b0ebfaeedfd",
    "name": "Query 3 and Query 2/4: Caregiver lateness and senior outreach",
    "description": "Tests GET /api/reports/caregiver-lateness (Query 3) and GET /api/reports/senior-outreach (Query 2/4). Field names follow the output columns of olap/sql/procs/CaregiverLateness.sql and SeniorOutreach.sql; status codes follow docs/Query1-Contract.md (v1.2).\n\nNormal run: run the collection with the \"Empty database\" and \"Database unavailable\" folders unticked. In each query folder the main GET must run before the query string request because it saves the response body for comparison.\n\nRun \"Empty database\" and \"Database unavailable\" on their own, with the API set up as described in each folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Query 3: Caregiver lateness",
      "item": [
        {
          "name": "GET caregiver lateness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let rows = [];",
                  "try { rows = pm.response.json(); } catch (e) {}",
                  "",
                  "pm.test(\"Status is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Body is a non-empty array\", () => {",
                  "  pm.expect(rows).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "// Same ordering rule as SQL Server's default case-insensitive collation",
                  "const byName = (a, b) => a.localeCompare(b, undefined, { sensitivity: \"base\" });",
                  "",
                  "pm.test(\"Each row has exactly caregiverName, avgMinutesLate\", () => {",
                  "  rows.forEach(r => {",
                  "    pm.expect(Object.keys(r)).to.have.members([\"caregiverName\", \"avgMinutesLate\"]);",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"Field types match the procedure output\", () => {",
                  "  rows.forEach(r => {",
                  "    pm.expect(r.caregiverName).to.be.a(\"string\").that.is.not.empty;",
                  "    pm.expect(r.avgMinutesLate).to.be.a(\"number\");",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"10 <= avgMinutesLate <= 60 (Late visits only, an average just over 10 rounds to 10.0), 1 decimal place\", () => {",
                  "  rows.forEach(r => {",
                  "    pm.expect(r.avgMinutesLate, r.caregiverName).to.be.at.least(10).and.at.most(60);",
                  "    pm.expect(Math.abs(r.avgMinutesLate * 10 - Math.round(r.avgMinutesLate * 10)), `${r.caregiverName} has 1 dp`).to.be.below(1e-9);",
                  "  });",
                  "});",
                  "",
                  "pm.test(\"Sorted by avgMinutesLate descending, then caregiverName\", () => {",
                  "  for (let i = 1; i < rows.length; i++) {",
                  "    const a = rows[i - 1], b = rows[i];",
                  "    const ordered = a.avgMinutesLate > b.avgMinutesLate",
                  "      || (a.avgMinutesLate === b.avgMinutesLate && byName(a.caregiverName, b.caregiverName) <= 0);",
                  "    pm.expect(ordered, `${a.caregiverName} then ${b.caregiverName}`).to.be.true;",
                  "  }",
                  "});",
                  "",
                  "// Saved so \"GET caregiver lateness with query string (ignored)\" can compare against it",
                  "pm.collectionVariables.set(\"q3Body\", pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/caregiver-lateness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "caregiver-lateness"
              ]
            },
            "description": "Happy path. Checks status, Content-Type, field names, field types, value ranges and sort order. Needs a star schema with at least one Late visit."
          },
          "response": []
        },
        {
          "name": "GET caregiver lateness with query string (ignored)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Same body as without a query string\", () => {",
                  "  pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get(\"q3Body\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/caregiver-lateness?caregiver=1&foo=bar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "caregiver-lateness"
              ],
              "query": [
                {
                  "key": "caregiver",
                  "value": "1"
                },
                {
                  "key": "foo",
                  "value": "bar"
                }
              ]
            },
            "description": "Query string parameters are ignored and still return 200 with the same body. Run after \"GET caregiver lateness\"."
          },
          "response": []
        }
      ]
